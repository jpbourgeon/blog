{
  "name": "jpbourgeon-blog",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build && node scripts/pagefind.mts",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "publication": "node --disable-warning=ExperimentalWarning scripts/publication/cli.mts",
