    "preflight": "node scripts/publication/preflight.mts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@types/react": "19.2.17",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.6.0",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "yaml": "2.8.3"
  },
  "engines": {
    "node": ">=26"
